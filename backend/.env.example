# Copy to .env (never commit .env)
# Render Postgres "External Database URL" locally, "Internal" when deployed on Render
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
PORT=4000

# Phase 4: admin auth
# Long random string (32+ chars) used to sign login tokens. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Seed-time admin accounts (read by `npm run db:seed`; passwords 12+ chars). Remove or blank the passwords after seeding.
ADMIN1_NAME=Zee
ADMIN1_EMAIL=
ADMIN1_PASSWORD=
ADMIN2_NAME=Marie Chris
ADMIN2_EMAIL=
ADMIN2_PASSWORD=
# Set to true for one seed run to overwrite existing admin passwords
ADMIN_RESET_PASSWORDS=false

# Phase 5: Cloudinary photo upload (Cloudinary dashboard -> Settings -> API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional; folder photos are uploaded into
CLOUDINARY_FOLDER=cebu-properties-by-mct
